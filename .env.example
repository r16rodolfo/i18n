# ─────────────────────────────────────────────────────────────
# R16 Meet: variáveis de ambiente
#
# Local: copie este arquivo para ".env.local" e preencha os valores.
# Vercel: cadastre as mesmas variáveis em Project → Settings →
#         Environment Variables.
#
# Nenhum destes valores chega ao navegador. Nunca coloque o
# prefixo NEXT_PUBLIC_ numa chave secreta.
# ─────────────────────────────────────────────────────────────


# ── Banco de dados (Supabase Postgres) ───────────────────────
# Onde: Supabase → seu projeto → botão "Connect" → ORMs / Connection string
#
# DATABASE_URL: conexão usada pelo app. Use o "Transaction pooler"
# (porta 6543). Troque [YOUR-PASSWORD] pela senha do banco.
# Exemplo:
# postgresql://postgres.abcdefghij:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# DATABASE_MIGRATION_URL (opcional, recomendado): usada só pelos
# comandos bun db:* para criar/alterar tabelas. Use o "Session pooler"
# (porta 5432). Se ficar vazia, usa a DATABASE_URL.
DATABASE_MIGRATION_URL=


# ── Login (Supabase Auth) ────────────────────────────────────
# Onde: Supabase → seu projeto → Project Settings → API Keys
# Estes dois são públicos (vão para o navegador de propósito). Use a
# "publishable key" (sb_publishable_...), nunca a "secret key".
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=


# ── Vídeo (Daily.co) ─────────────────────────────────────────
# Onde: dashboard.daily.co → Developers → API key
# Usada pelo servidor para criar salas e gerar os passes de entrada (tokens).
DAILY_API_KEY=


# ── Inteligência artificial (OpenAI) ─────────────────────────
# Onde: platform.openai.com → API keys
# Usada pelo agente da reunião (perguntas, resumo, sugestão de e-mail).
OPENAI_API_KEY=

# Modelo usado pelo agente. Dá para trocar aqui sem mexer no código.
OPENAI_MODEL=gpt-5.1


# ── Tradução ─────────────────────────────────────────────────
# Qual serviço traduz a chamada:
#   none    → chamada comum, todos ouvem a voz original (padrão)
#   palabra → Palabra.ai (você ouve só a voz traduzida dos outros)
# Se as chaves da Palabra estiverem vazias, o app volta sozinho para "none".
TRANSLATION_PROVIDER=none

# Onde: painel da Palabra.ai → API keys. Só precisa com TRANSLATION_PROVIDER=palabra
PALABRA_CLIENT_ID=
PALABRA_CLIENT_SECRET=


# ── E-mail (Resend), opcional ────────────────────────────────
# Onde: resend.com → API Keys. Sem chave, os e-mails são só
# "simulados" (aparecem no log do servidor, nada é enviado).
RESEND_API_KEY=
# Remetente. Precisa ser de um domínio verificado no Resend (ex.: reunioes@r16.com.br).
RESEND_FROM_EMAIL=


# ── Busca na web para o agente (Exa), opcional ───────────────
# Onde: dashboard.exa.ai → API keys. Sem chave, o agente só não
# pesquisa na internet.
EXA_API_KEY=
