# ─────────────────────────────────────────────────────────────
# R16 Meet: environment variables
#
# Local: copy this file to ".env.local" and fill in the values.
# Vercel: add the same variables under Project → Settings →
#         Environment Variables.
#
# None of these values ever reaches the browser. Never add the
# NEXT_PUBLIC_ prefix to a secret key.
# ─────────────────────────────────────────────────────────────


# ── Database (Supabase Postgres) ─────────────────────────────
# Where: Supabase → your project → "Connect" button → ORMs / Connection string
#
# DATABASE_URL: the app's connection. Use the "Transaction pooler"
# (port 6543). Replace [YOUR-PASSWORD] with the database password.
# Example:
# postgresql://postgres.abcdefghij:[YOUR-PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# DATABASE_MIGRATION_URL (optional, recommended): used only by the
# bun db:* commands to create/change tables. Use the "Session pooler"
# (port 5432). If empty, DATABASE_URL is used.
DATABASE_MIGRATION_URL=


# ── Video (Daily.co) ─────────────────────────────────────────
# Where: dashboard.daily.co → Developers → API key
# Used by the server to create rooms and generate entry passes (tokens).
DAILY_API_KEY=


# ── Artificial intelligence (OpenAI) ─────────────────────────
# Where: platform.openai.com → API keys
# Used by the meeting agent (questions, summary, email suggestion).
OPENAI_API_KEY=

# Model used by the agent. Change it here without touching the code.
OPENAI_MODEL=gpt-5.1


# ── Translation ──────────────────────────────────────────────
# Which service translates the call:
#   none    → plain call, everyone hears the original voice (default)
#   palabra → Palabra.ai (you hear only the translated voice of the others)
# If Palabra's keys are empty, the app falls back to "none" automatically.
TRANSLATION_PROVIDER=none

# Where: Palabra.ai panel → API keys. Only needed with TRANSLATION_PROVIDER=palabra
PALABRA_CLIENT_ID=
PALABRA_CLIENT_SECRET=


# ── Email (Resend) — optional ───────────────────────────────
# Where: resend.com → API Keys. Without a key, emails are only
# "simulated" (they show up in the server log, nothing is sent).
RESEND_API_KEY=
# Sender. Must belong to a domain verified in Resend (e.g. reunioes@r16.com.br).
RESEND_FROM_EMAIL=


# ── Web search for the agent (Exa) — optional ────────────────
# Where: dashboard.exa.ai → API keys. Without a key, the agent
# just doesn't search the internet.
EXA_API_KEY=
